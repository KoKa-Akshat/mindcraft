rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;

      // Create: own doc, no privileged links; role may only be student.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
             'childId', 'childIds', 'tutorId', 'tutorIds', 'classroomId',
             'assignedTutorId', 'assignedTutorIds', 'assignedTutorName',
             'program', 'stickerPlan',
           ])
        && (!('role' in request.resource.data) || request.resource.data.role == 'student');

      // Update: own doc, may not touch privileged links; may set role to
      // student only when the existing doc had no role yet.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny([
               'childId', 'childIds', 'tutorId', 'tutorIds', 'classroomId',
               'assignedTutorId', 'assignedTutorIds', 'assignedTutorName',
               'program', 'stickerPlan',
             ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (!('role' in resource.data) && request.resource.data.role == 'student')
        );
    }

    // Invite-only sign-in gate (see app/src/lib/loginAllowlist.ts + postLogin.ts).
    // Doc id = lowercased email. Any signed-in user may read (needed at
    // first-login time, before their own users/{uid} doc exists) — same
    // permissiveness precedent as users/{userId}'s own unconditional read
    // rule just above. Only an admin may add/remove entries.
    match /login_allowlist/{emailId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email ||
        resource.data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null && (
        request.resource.data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null && (
        resource.data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        resource.data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentEmail == request.auth.token.email ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.tutorId == request.auth.uid
        );
      }

      // New (TUTOR_PARENT_CLASSROOM_PLAN.md §3) — student-authored async
      // reasoning capture. Append-only from the client: students create their
      // own entries, tutors read all entries for their own sessions, nobody
      // edits/deletes from the client.
      match /studentWork/{entryId} {
        allow create: if request.auth != null
          && request.resource.data.studentId == request.auth.uid
          && (
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid
            || get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentEmail == request.auth.token.email
          );
        // NOTE: must depend only on the parent session doc's fields, never on
        // resource.data of the studentWork doc itself — both StudentSessions.tsx
        // (pending-work check) and SessionDetail.tsx (tutor review) call
        // getDocs()/onSnapshot() on this subcollection with NO where filter, and
        // Firestore rejects an entire unfiltered list() if the rule can't be
        // proven safe without per-document resource.data evaluation.
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentEmail == request.auth.token.email ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.tutorId == request.auth.uid
        );
        allow update, delete: if false;
      }
    }

    match /student_work/{docId} {
      allow create, update: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      );
      allow delete: if false;
    }

    // Self-directed homework upload sessions (HOMEWORK_UPLOAD feature). Same
    // shape as student_work: a student owns and can update only their own
    // session doc; a linked parent can read their child's.
    match /homework_sessions/{docId} {
      allow create, update: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      );
      allow delete: if false;
    }

    // Per-question "gap" notes (WRONG_ANSWER_NOTES feature): the first wrong
    // pick a student makes on a question, plus a diagnosis, kept open until
    // that exact question is answered correctly again. Same shape as
    // student_work / homework_sessions: a student owns and can update only
    // their own notes; a linked parent can read their child's.
    match /wrong_answer_notes/{docId} {
      allow create, update: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      );
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        chatId.split('_')[0] == request.auth.uid ||
        chatId.split('_')[1] == request.auth.uid
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          chatId.split('_')[0] == request.auth.uid ||
          chatId.split('_')[1] == request.auth.uid
        );
      }
    }

    match /transcripts/{transcriptId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tutor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if false;
    }

    // New (TUTOR_PARENT_CLASSROOM_PLAN.md §1) — classroom join-code roster.
    // Only the Admin-SDK webhook endpoints (join-classroom, create-classroom)
    // write these; any signed-in user can read (needed for a student to see
    // their own classroom's tutor name/roster after joining).
    match /classrooms/{classroomId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // New (TUTOR_PARENT_CLASSROOM_PLAN.md §4) — previously UNCOVERED by any
    // rule (confirmed via the live Firebase Rules API, not just the stale
    // git snapshot). This blocked BOTH: (a) ParentDashboard.tsx reading a
    // linked child's data, and (b) QAToolbar.tsx reading/deleting the
    // CURRENT user's own interactions/knowledge_graphs — i.e. this was
    // broken for direct client access generally, not only the parent case.
    // Writes are Admin SDK only (the ML backend's server-side Firestore
    // client bypasses rules entirely) EXCEPT the existing QA "delete my own
    // knowledge graph" restart-fresh flow, explicitly allowed below.
    match /interactions/{interactionId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        // Footnote fix (LIVE_CALL_SESSIONS build, same PR as liveSessions
        // below): interaction docs carry no tutorId field of their own, so
        // the tutor check cross-references the student's OWN user doc
        // (Admin-SDK-authoritative), same source of truth flagged_questions
        // uses at create-time. Previously this had no tutor clause at all —
        // TutorDashboard.tsx's live-activity onSnapshot on interactions was
        // denied for real tutors.
        get(/databases/$(database)/documents/users/$(resource.data.studentId)).data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      );
      allow write: if false;
    }

    match /learning_events/{eventId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      );
      allow write: if false;
    }

    // Student-flagged practice questions → surfaced on the tutor dashboard.
    // A student may only flag to their OWN linked tutor (users/{uid}.tutorId,
    // which is Admin-SDK-written via the classroom join flow, so it can't be
    // spoofed client-side). Tutors may mark their own flags resolved.
    match /flagged_questions/{flagId} {
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.tutorId is string
        && request.resource.data.tutorId ==
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tutorId;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid
      );
      allow update: if request.auth != null
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow delete: if request.auth != null && resource.data.tutorId == request.auth.uid;
    }

    // Live "Call" co-working sessions (snuggly-wandering-candle plan, step 1).
    // A student-initiated synced session (question/paper context + a shared
    // scratchpad, written as append-only strokes below) that their OWN
    // linked tutor (users/{uid}.tutorId, Admin-SDK-set — same spoofing
    // defense as flagged_questions' create-time cross-check) and/or a linked
    // parent (childId/childIds, same pattern as student_work/interactions)
    // can join, read, and draw into. No new trust boundary — same three
    // relationships already governed elsewhere in this file.
    match /liveSessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && (
          request.resource.data.tutorId == null ||
          request.resource.data.tutorId ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tutorId
        );
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      );
      // Any of the three authorized participants may update lifecycle fields
      // (status/lastActivityAt/endedAt — e.g. the student's unmount effect
      // ending the session, or a joiner's activity ping); studentId/tutorId
      // stay immutable post-create so a joiner can never reassign the
      // session to a different tutor.
      allow update: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == resource.data.studentId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([resource.data.studentId]))
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'tutorId']);
      allow delete: if false;

      // Append-only, one doc per completed stroke (two people drawing at
      // once don't clobber each other). MUST resolve access via get() on the
      // PARENT liveSessions doc only, never resource.data on the stroke
      // itself — LiveSessionPage's onSnapshot on this subcollection has no
      // where() filter, and Firestore rejects an entire unfiltered list()
      // if the rule can't be proven safe without per-document resource.data
      // evaluation (same constraint documented on sessions/{id}/studentWork
      // above).
      match /strokes/{strokeId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.studentId == request.auth.uid ||
          get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId ==
            get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.studentId ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
           && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny(
                [get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.studentId]))
        );
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && (
            get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.studentId == request.auth.uid ||
            get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.tutorId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId ==
              get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.studentId ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny(
                  [get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.studentId]))
          );
        allow update, delete: if false;
      }
    }

    match /knowledge_graphs/{studentId} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == studentId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds is list
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds.hasAny([studentId]))
      );
      allow delete: if request.auth != null && request.auth.uid == studentId;
      allow create, update: if false;
    }

    // Marketing site leads + follow-up email draft (Admin SDK writes leads;
    // signed-in admins manage the draft and read the inbox in Admin).
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /marketing_leads/{leadId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /marketing_settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
