# Xcode build artifacts — huge, regenerable, never worth versioning.
DerivedData/
build/
*.xcuserstate
xcuserdata/
.build/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Swift Package Manager local checkouts (regenerable via Xcode's package
# resolution) — mirrors the same convention as build/DerivedData above.
.swiftpm/
Package.resolved

# MyScriptRecognizer.swift is now a committed stub (compiles everywhere).
# If you add a local credentials override, keep secrets out of git:
MindCraftNotes/MindCraftNotes/Networking/MyScriptRecognizer+Secrets.swift
MindCraftNotes/MindCraftNotes/Networking/MyScriptSecrets.swift

# Real-device test screenshot dumps — large binaries, regenerable via
# xcresulttool, not meaningful to diff.
screenshots_realdevice_*/
*.xcresult/
