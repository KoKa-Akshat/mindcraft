# MindCraft environment variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# ── Anthropic (required by all Claude calls) ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Marketing agent (optional live ANGLE/WRITE + personality judge) ──────────
GROQ_API_KEY=your_groq_key_here
MARKETING_MODEL=llama-3.3-70b-versatile
# Drive publishing (batch inspection surface). Personal Gmail must use OAuth: service
# accounts have no storage quota and can only own files in a Workspace Shared Drive.
# Create a Desktop-app OAuth client, then run: npm run marketing:drive-auth
MARKETING_DRIVE_CLIENT_ID=your_oauth_client_id
MARKETING_DRIVE_CLIENT_SECRET=your_oauth_client_secret
MARKETING_DRIVE_REFRESH_TOKEN=written_by_marketing:drive-auth
# Workspace Shared Drive only — leave unset on personal Gmail.
MARKETING_DRIVE_SERVICE_ACCOUNT=
# Leave empty: drive.file cannot see folders made by hand, so the pipeline creates its own.
MARKETING_DRIVE_FOLDER_ID=

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to a Firebase service account JSON (for Python services)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── Webhook (Vercel) ──────────────────────────────────────────────────────────
# Firebase Admin SDK credentials (set in Vercel env panel, not a file)
FIREBASE_PROJECT_ID=mindcraft-93858
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── ML server (Cloud Run) ─────────────────────────────────────────────────────
ML_URL=https://mindcraft-ml-630302850770.us-central1.run.app

# ── Homework service (Cloud Run) ──────────────────────────────────────────────
HOMEWORK_API_URL=http://localhost:8001

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_ML_API_URL=https://mindcraft-ml-630302850770.us-central1.run.app
VITE_HOMEWORK_API_URL=http://localhost:8001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
