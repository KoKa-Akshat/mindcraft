rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat-files/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        chatId.split('_')[0] == request.auth.uid ||
        chatId.split('_')[1] == request.auth.uid
      );
    }
    match /sessions/{sessionId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid}/stickers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 300 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|svg\\+xml)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Tutor profile photo + resume (Tutor Dashboard).
    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Binder uploads (BYOB — "Bring Your Own Book", ios-prototype
    // MindCraftNotes app): source files a student uploads to bind into a
    // custom field book, one folder per binder_items Firestore doc
    // (binder/{studentId}/{itemId}/{fileName}). This is private study
    // material, not a public profile photo, so — unlike users/{uid}/profile
    // above — read is owner-only too. Ownership check mirrors the Firestore
    // binder_items rule's studentId == request.auth.uid gate exactly.
    match /binder/{studentId}/{itemId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == studentId;
      allow write: if request.auth != null && request.auth.uid == studentId
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Marketing tutor applications: anonymous upload of resume + photo, then
    // download links are emailed via FormSubmit. Tokenized download URLs work
    // even without public read. Size + content-type capped to limit abuse.
    match /tutor-applications/{applicationId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }
  }
}
