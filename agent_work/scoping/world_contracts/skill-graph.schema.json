{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindcraft.app/schemas/world/skill-graph-v1.json",
  "title": "MindCraft Skill Graph v1",
  "description": "A pinned graph of deterministic Skill Block instances.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "version",
    "title",
    "summary",
    "blocks",
    "edges",
    "boundaryInputs",
    "boundaryOutputs",
    "seed",
    "tickMs",
    "checkpointPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "graphId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instanceId", "blockId", "blockVersion", "contentHash"],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "blockId": {
            "type": "string"
          },
          "blockVersion": {
            "type": "string"
          },
          "contentHash": {
            "$ref": "#/$defs/sha256"
          },
          "initialState": {
            "type": "object",
            "additionalProperties": true
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "from", "to"],
        "properties": {
          "edgeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "from": {
            "$ref": "#/$defs/portRef"
          },
          "to": {
            "$ref": "#/$defs/portRef"
          }
        }
      }
    },
    "boundaryInputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/portRef"
      }
    },
    "boundaryOutputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/portRef"
      }
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tickMs": {
      "type": "integer",
      "minimum": 16,
      "maximum": 60000
    },
    "checkpointPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["afterInputEvents", "afterSimulatedSeconds"],
      "properties": {
        "afterInputEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "afterSimulatedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "displayName"],
      "properties": {
        "kind": {
          "enum": ["student", "tutor", "staff", "community"]
        },
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "remixOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphId", "version", "contentHash"],
      "properties": {
        "graphId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "portRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "portId"],
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "portId": {
          "type": "string"
        }
      }
    }
  }
}
