{
  "emulators": {
    "firestore": {
      "port": 8091
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": [
    {
      "target": "world1",
      "public": "worlds/world2",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*_unpacked_*",
        "**/*_transcoded_*",
        "**/*_orig.ktx2",
        "**/tools/**",
        "**/*.astc",
        "**/*.dds",
        "**/*.ktx",
        "**/*.map"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/main.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/bundle*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/mc-world-chrome.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/mc-world-nav.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/mc-diagnostic.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/mc-diagnostic.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/data/actDiagnostic.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "marketing",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        ".git/**",
        ".github/**",
        ".firebase/**",
        ".claude/**",
        ".local/**",
        ".scratch-pdf-venv/**",
        ".cursor/**",
        "**/node_modules/**",
        "app/**",
        "functions/**",
        "webhook/**",
        "ml/**",
        "homework/**",
        "worlds/**",
        "docs/**",
        "ios-prototype/**",
        "agent_work/**",
        "pitch/**",
        "marketing/**",
        "memory/**",
        "data/**",
        "scripts/**",
        "spark/**",
        "firebase/**",
        "generated_chapter_images/**",
        "generated_chapter_images_manifest.json",
        "push.sh",
        "img/*.3mf",
        "img/*.tex",
        "img/*.pptx",
        "img/*.mp3",
        "img/*.py",
        "package*.json",
        "firestore*",
        "storage.rules",
        "serve-spa.mjs",
        "make_deck.py",
        "*.pdf",
        "*.xlsx",
        "*.pptx",
        "*.md",
        "*.log",
        "*.zip",
        "Logo.png",
        "kite.jpg"
      ],
      "rewrites": [],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/dans-archive.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/sims/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
