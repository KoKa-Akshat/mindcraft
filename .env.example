# MindCraft environment variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# ── Anthropic (required by all Claude calls) ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Marketing agent (optional live ANGLE/WRITE + personality judge) ──────────
GROQ_API_KEY=your_groq_key_here
MARKETING_MODEL=llama-3.3-70b-versatile
# Drive publishing (batch inspection surface). Service account needs write access to the
# shared folder; path to a service-account JSON, or the JSON itself.
MARKETING_DRIVE_SERVICE_ACCOUNT=./marketing-drive-service-account.json
MARKETING_DRIVE_FOLDER_ID=your_shared_drive_folder_id

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to a Firebase service account JSON (for Python services)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── Webhook (Vercel) ──────────────────────────────────────────────────────────
# Firebase Admin SDK credentials (set in Vercel env panel, not a file)
FIREBASE_PROJECT_ID=mindcraft-93858
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── ML server (Cloud Run) ─────────────────────────────────────────────────────
ML_URL=https://mindcraft-ml-630302850770.us-central1.run.app

# ── Homework service (Cloud Run) ──────────────────────────────────────────────
HOMEWORK_API_URL=http://localhost:8001

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_ML_API_URL=https://mindcraft-ml-630302850770.us-central1.run.app
VITE_HOMEWORK_API_URL=http://localhost:8001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
